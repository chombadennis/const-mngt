# .env.example - copy to .env and fill values
# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-locally
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (example for Neon / Postgres)
# DATABASE_URL=postgres://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cm_db

# Storage provider: local | cloudinary | r2
STORAGE_PROVIDER=local

# Cloudinary (if using cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2 (if using R2)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=  # e.g. https://<accountid>.r2.cloudflarestorage.com
R2_REGION=

# JWT / Auth
SIMPLE_JWT_SECRET=replace-with-secret-or-use-django-secret

# CORS for frontend (Vercel domain)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Sentry
SENTRY_DSN=

# Celery/Redis for optional background tasks
REDIS_URL=redis://localhost:6379/0

# MPesa placeholders (do NOT store production secrets in repo)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=

# Neon / Railway / Fly tokens - example placeholders (store in CI/hosting secrets)
NEON_URL= # e.g. postgres://username:password@<host>/<db>
RAILWAY_API_KEY=
FLY_API_TOKEN=
